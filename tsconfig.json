{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo.json"
  },
  "include": [
    "src",
    "test",
    "rolldown.config.ts"
  ]
}
