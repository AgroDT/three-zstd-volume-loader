{
  "name": "@agrodt/three-zstd-volume-loader",
  "version": "0.3.0",
  "description": "A Three.js plugin for loading volumetric data (e.g., CT scan results) compressed using ZSTD.",
  "author": "Petr Tsymbarovich <petr@tsymbarovich.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgroDT/three-zstd-volume-loader.git"
  },
  "bugs": {
    "url": "https://github.com/AgroDT/three-zstd-volume-loader/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src/**/*.ts"
  ],
  "exports": {
    ".": {
      "import": "./dist/agrodt-three-zstd-volume-loader.min.js",
      "types": "./dist/agrodt-three-zstd-volume-loader.d.ts"
    },
    "./zstddeclib.wasm": {
      "import": "./dist/zstddeclib.wasm"
    }
  },
  "scripts": {
    "check": "tsc",
    "prepare": "rolldown -c",
    "test": "node --experimental-strip-types --test --experimental-test-coverage test/*.ts"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/three": "0.184.1",
    "rolldown": "1.1.1",
    "rolldown-plugin-dts": "0.25.2",
    "three": "0.184.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "three": ">=0.184.0"
  }
}
